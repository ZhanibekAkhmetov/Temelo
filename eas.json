{
  "cli": {
    "version": ">= 21.4.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_TEMELO_WEB_URL": "https://temelo.zhanik.workers.dev"
      }
    },
    "preview": {
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_TEMELO_WEB_URL": "https://temelo.zhanik.workers.dev"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_TEMELO_WEB_URL": "https://temelo.zhanik.workers.dev"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
