# Share links (milestone 14.6). Copy to .env.local (gitignored) and adjust.
# Expo inlines EXPO_PUBLIC_* variables into the bundle when it is built, so
# restart `npm run web` / `npx expo start` after changing them.
#
# Without EXPO_PUBLIC_TEMELO_SERVER_URL the app offers no share links and needs
# no network at all.

# Where the share-link server (server/) answers. While developing:
#  - web build:  http://localhost:8080
#  - phone:      http://<this computer's LAN IP>:8080 (same Wi-Fi; a
#                development build allows plain http, a release build does not)
EXPO_PUBLIC_TEMELO_SERVER_URL=http://localhost:8080

# Where the web app is — what a share link points at. A browser uses its own
# address when this is unset; a phone needs it to make a link at all.
# EXPO_PUBLIC_TEMELO_WEB_URL=http://localhost:8081
