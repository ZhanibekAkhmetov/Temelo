{
  "expo": {
    "name": "Temelo",
    "slug": "Temelo",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/branding/icon.png",
    "scheme": "temelo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/branding/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E5EEFF",
        "foregroundImage": "./assets/branding/adaptive-icon-foreground.png",
        "monochromeImage": "./assets/branding/adaptive-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.zhanibekakhmetov.temelo",
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/branding/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/branding/splash-icon.png",
          "imageWidth": 180,
          "dark": {
            "backgroundColor": "#202124"
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/branding/notification-icon.png",
          "color": "#208AEF"
        }
      ],
      "expo-localization",
      [
        "expo-sharing",
        {
          "android": {
            "enabled": true,
            "singleShareMimeTypes": ["application/octet-stream"]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b01c1bed-08e3-441c-aff3-69c46745193f"
      }
    }
  }
}
